load("@aspect_bazel_lib//lib:expand_template.bzl", "expand_template_rule")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

genrule(
    name = "proj_config_strip_version",
    srcs = ["cmake/proj_config.cmake.in"],
    outs = ["proj_config_stripped.cmake.in"],
    cmd = "sed '/cmakedefine VERSION/d' $< > $@",
)

_SUBSTITUTIONS = {
    "cmakedefine": "define",
    "${PACKAGE}": "proj",
    "${PACKAGE_BUGREPORT}": "",
    "${PACKAGE_NAME}": "proj",
    "${PACKAGE_TARNAME}": "proj",
    "${PACKAGE_VERSION}": "0.0.1",
    "${VERSION}": "9.4.1",
    "${PACKAGE_STRING}": "proj-9.4.1",
}

expand_template_rule(
    name = "proj_config_generate",
    out = "proj_config.h",
    stamp_substitutions = _SUBSTITUTIONS,
    substitutions = _SUBSTITUTIONS,
    template = ":proj_config_strip_version",
)

cc_library(
    name = "proj",
    srcs = glob(
        [
            "src/**/*.cpp",
            "src/**/*.c",
        ],
        allow_empty = False,
        exclude = [
            "src/tests/*",
            "src/apps/*",
        ],
    ),
    hdrs = glob(
        [
            "src/**/*.h",
            "src/**/*.hpp",
            "include/**/*.hpp",
        ],
        allow_empty = False,
    ) + [":proj_config_generate"],
    copts = [
        "-I.",
        "-I$(GENDIR)",
    ],
    includes = [
        "include",
        "src",
    ],
    visibility = ["//visibility:public"],
    deps = ["@sqlite3"],
)
